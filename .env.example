# FaceFlux Environment Configuration
# ──────────────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT: is file ko copy karke .env banao
#   cp .env.example .env
#
# RAILWAY/RENDER: ye sab dashboard mein Environment Variables mein set karo
# ──────────────────────────────────────────────────────────────────────────────

# ── Server binding ─────────────────────────────────────────────────────────────
# Local ke liye: 127.0.0.1 (sirf tumhara machine access kar sake)
# Railway ke liye: 0.0.0.0 (internet se accessible)
HOST=127.0.0.1

# PORT Railway/Render apne aap set karta hai — local ke liye comment hi rehne do
# PORT=8000

# ── CORS ───────────────────────────────────────────────────────────────────────
# Frontend deploy karne ke baad Vercel URL yahaan add karo
# Example: CORS_ORIGINS=https://faceflux.vercel.app
CORS_ORIGINS=

# ── Directories ────────────────────────────────────────────────────────────────
MODEL_DIR=data/models
UPLOAD_DIR=data/uploads
OUTPUT_DIR=data/outputs
TEMP_DIR=data/temp
FRAMES_DIR=data/frames
LOG_DIR=data/logs

# ── Upload Limits ───────────────────────────────────────────────────────────────
MAX_VIDEO_SIZE_MB=2048
MAX_IMAGE_SIZE_MB=50

# ── Processing ─────────────────────────────────────────────────────────────────
# GPU_PROVIDER: auto | cuda | cpu
GPU_PROVIDER=auto
DEFAULT_QUALITY=balanced
MAX_CONCURRENT_JOBS=1
FRAME_BATCH_SIZE=32

# ── Output Video ───────────────────────────────────────────────────────────────
OUTPUT_CODEC=libx264
OUTPUT_CRF=18
OUTPUT_PRESET=medium

# ── Face Detection ─────────────────────────────────────────────────────────────
# DET_SIZE 32 ka multiple hona chahiye (320, 480, 640)
DET_SIZE=640
FACE_SCORE_THRESHOLD=0.5

# ── Face Enhancer (GPEN ONNX) ──────────────────────────────────────────────────
# ENHANCER_MODEL: gpen_512 (best quality) | gpen_256 (faster) | gfpgan
ENHANCER_MODEL=gpen_512
# ENHANCER_FIDELITY: 0.0 = max AI enhancement | 1.0 = max fidelity to original
# 0.8 = recommended (sharp + natural looking)
ENHANCER_FIDELITY=0.8
# COLOR_CORRECTION: LAB histogram matching for natural skin tone blending
# true = enabled (recommended) | false = disable
COLOR_CORRECTION=true
