# FaceFlux — MacBook Air M5 Optimized Config
# Copy this to .env when running on Apple Silicon:
#   cp .env.mac .env

# ─── GPU / ONNX ───────────────────────────────────────────────────────────────
# "auto" lets hardware_service auto-detect CoreMLExecutionProvider
GPU_PROVIDER=auto

# ─── Video Encoding ──────────────────────────────────────────────────────────
# hevc_videotoolbox → Apple Silicon HEVC hardware encoder.
#   - ~40% smaller files vs H.264 at the same visual quality.
#   - Plays in QuickTime, IINA, and all modern players on macOS.
#   - Uses -tag:v hvc1 for QuickTime compatibility (set automatically in ffmpeg.py).
# Use "auto" to let the code decide (resolves to hevc_videotoolbox on Mac).
OUTPUT_CODEC=hevc_videotoolbox
# CRF is used on Linux. On macOS, vt_quality in QUALITY_SETTINGS takes over.
OUTPUT_CRF=18
OUTPUT_PRESET=medium

# ─── Processing ──────────────────────────────────────────────────────────────
DEFAULT_QUALITY=balanced
MAX_CONCURRENT_JOBS=1

# Keep the in-flight frame queue small on a 16GB fanless Mac.
FRAME_BATCH_SIZE=8
MAX_FRAME_WORKERS=2

# Low-motion 720p clips: update landmarks every 6 frames (~5 times/sec at 30fps).
# The tracker transforms landmarks between detector frames.
DET_SAMPLE_RATE=6

# GPEN-256 on every second frame is a good long-video balance.
ENHANCE_FRAME_STRIDE=2

# Face-only temporal smoothing is enabled in the pipeline. Disable whole-frame
# FFmpeg denoise for long clips to avoid background ghosting and extra runtime.
TEMPORAL_NR=false

# ─── Face Detection ──────────────────────────────────────────────────────────
# 640 = full quality detection. Can lower to 320 for "fast" mode on very long clips.
# 512 is sufficient for 720p clips and reduces detector cost on long jobs.
DET_SIZE=512
FACE_SCORE_THRESHOLD=0.5

# ─── Enhancement ─────────────────────────────────────────────────────────────
ENHANCER_MODEL=gpen_256
# 0.0 = max enhancement, 1.0 = max fidelity. 0.8 = good balance.
ENHANCER_FIDELITY=0.8
COLOR_CORRECTION=true

# ─── Limits ──────────────────────────────────────────────────────────────────
# M5 SSD is fast — allow bigger uploads
MAX_VIDEO_SIZE_MB=4096
MAX_IMAGE_SIZE_MB=100
